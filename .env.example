# .env.example — Referencia de variables de entorno.
# Copia este archivo a .env y completa los valores reales.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Rutas de base de datos (opcionales — por defecto usan data/*.db relativo al proyecto)
# FACEBOOK_DB=/ruta/absoluta/a/facebook.db
# TIKTOK_DB=/ruta/absoluta/a/tiktok.db
# EXTERNOS_DB=/ruta/absoluta/a/externos.db

# Directorio de datos y salidas (opcionales)
# DATA_DIR=/ruta/absoluta/a/data
# OUTPUT_DIR=/ruta/absoluta/a/outputs
