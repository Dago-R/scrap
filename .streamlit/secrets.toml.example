# Plantilla de secretos para Streamlit.
# 1) Copia este archivo a: .streamlit/secrets.toml
# 2) Completa tus claves reales.
# 3) NUNCA subas secrets.toml al repositorio (ya está en .gitignore).
#
# En producción (Railway), estas variables van en el gestor de secretos del host,
# no en este archivo.

# Contraseña del panel de carga del analista
PANEL_PASSWORD = "tu_contraseña_aqui"
